private theorem signs_checked : signsOK 15 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 14 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 14 scale numerators traces (by decide +kernel) (by decide +kernel)
    (trace_list_certificate 15 33 trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 33) :
    ((FaceOrder.ehrhartPolynomial 14).coeff j.val < 0 ↔ negativeIndex 15 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 14).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

