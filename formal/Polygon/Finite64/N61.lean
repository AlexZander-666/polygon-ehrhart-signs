private theorem trace_evaluated : NewtonTraceCache.traceRow 61 125 = traces := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem values_checked : valuesOK 125 scale numerators traces = true := by decide +kernel

private theorem signs_checked : signsOK 61 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 60 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 60 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 61 125 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 125) :
    ((FaceOrder.ehrhartPolynomial 60).coeff j.val < 0 ↔ negativeIndex 61 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 60).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

end Polygon.Finite64.N61
