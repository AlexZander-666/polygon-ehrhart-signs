  certify_scaled 36 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 37 77 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 77) :
    ((FaceOrder.ehrhartPolynomial 36).coeff j.val < 0 ↔ negativeIndex 37 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 36).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

end Polygon.Finite64.N37
