private theorem trace_evaluated : NewtonTraceCache.traceRow 51 105 = traces := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem values_checked : valuesOK 105 scale numerators traces = true := by decide +kernel

private theorem signs_checked : signsOK 51 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 50 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 50 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 51 105 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 105) :
    ((FaceOrder.ehrhartPolynomial 50).coeff j.val < 0 ↔ negativeIndex 51 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 50).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

end Polygon.Finite64.N51
