private theorem values_checked : valuesOK 31 scale numerators traces = true := by decide +kernel

private theorem signs_checked : signsOK 14 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 13 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 13 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 14 31 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 31) :
    ((FaceOrder.ehrhartPolynomial 13).coeff j.val < 0 ↔ negativeIndex 14 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 13).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

