private theorem signs_checked : signsOK 13 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 12 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 12 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 13 29 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 29) :
    ((FaceOrder.ehrhartPolynomial 12).coeff j.val < 0 ↔ negativeIndex 13 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 12).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

