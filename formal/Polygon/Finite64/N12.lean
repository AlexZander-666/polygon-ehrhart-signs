private theorem trace_evaluated : NewtonTraceCache.traceRow 12 27 = traces := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem values_checked : valuesOK 27 scale numerators traces = true := by decide +kernel

private theorem signs_checked : signsOK 12 numerators = true := by decide +kernel

theorem polynomial_eq :
    FaceOrder.ehrhartPolynomial 11 = Small.fromCoeffs (normalized scale numerators) :=
  certify_scaled 11 scale numerators traces (by decide +kernel) (by decide +kernel)
    (NewtonTraceCache.trace_list_certificate 12 27 (by decide) (by decide) trace_evaluated) (valuesOK_sound values_checked)

theorem signs (j : Fin 27) :
    ((FaceOrder.ehrhartPolynomial 11).coeff j.val < 0 ↔ negativeIndex 12 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 11).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

