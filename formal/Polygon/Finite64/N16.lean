theorem signs (j : Fin 35) :
    ((FaceOrder.ehrhartPolynomial 15).coeff j.val < 0 ↔ negativeIndex 16 j.val) ∧
      ((FaceOrder.ehrhartPolynomial 15).coeff j.val ≠ 0) :=
  signsOK_sound (by decide +kernel) polynomial_eq signs_checked j

